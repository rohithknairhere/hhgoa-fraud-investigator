// HHGOA_IEEE schema for the challenge dataset (README "Suggested graph schema", extended).
CREATE VERTEX Customer (PRIMARY_ID customer_id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID card_id STRING, card4 STRING, card6 STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID txn_id STRING, ts DATETIME, amount DOUBLE, product_cd STRING, channel STRING,
    risk_score DOUBLE, memory_score DOUBLE, addr1 STRING, id_15 STRING, id_23 STRING, m4 STRING, m6 STRING)
    WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID profile STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID domain STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID addr1 STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID case_id STRING, outcome STRING, pattern STRING, exposure_usd DOUBLE,
    report_filed STRING, opened_at DATETIME, actions_taken STRING, analyst_notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX InvestigationCase (PRIMARY_ID case_id STRING, status STRING, verdict STRING, fraud_probability DOUBLE,
    pattern STRING, exposure_usd DOUBLE, summary STRING, sar_filed BOOL, final_actions STRING, opened_at DATETIME)
    WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_OF"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF"
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction) WITH REVERSE_EDGE="PREV"
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="HAS_CASE"
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_IN"
CREATE DIRECTED EDGE CASE_FLAGS (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="FLAGGED_BY"
CREATE DIRECTED EDGE CASE_AFFECTS (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="AFFECTED_BY"
CREATE DIRECTED EDGE CASE_ON_CARD (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="CARD_HAS_INVESTIGATION"
CREATE DIRECTED EDGE CASE_CITES (FROM InvestigationCase, TO ClosedCase) WITH REVERSE_EDGE="CITED_BY"
CREATE DIRECTED EDGE CASE_LINKS_CARD (FROM InvestigationCase, TO Card) WITH REVERSE_EDGE="LINKED_BY_CASE"
CREATE DIRECTED EDGE CASE_DEVICE (FROM InvestigationCase, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_IN_CASE"

CREATE GRAPH HHGOA_IEEE (Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase,
    InvestigationCase, OWNS, OWNED_BY, MADE, MADE_BY, FROM_DEVICE, DEVICE_OF, PURCHASER_EMAIL, EMAIL_OF, BILLED_IN,
    REGION_OF, NEXT, PREV, INVOLVES, INVOLVED_IN, ON_CARD, HAS_CASE, CONNECTED_TO, CONNECTED_IN, CASE_FLAGS, FLAGGED_BY,
    CASE_AFFECTS, AFFECTED_BY, CASE_ON_CARD, CARD_HAS_INVESTIGATION, CASE_CITES, CITED_BY, CASE_LINKS_CARD,
    LINKED_BY_CASE, CASE_DEVICE, DEVICE_IN_CASE)
