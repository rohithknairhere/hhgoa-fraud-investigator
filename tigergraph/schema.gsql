// HHGOA_IEEE — property graph over the IEEE-CIS fraud detection dataset.
// Vertex attributes follow the Kaggle column names where one exists
// (TransactionAmt → amount, TransactionDT → ts, ProductCD → product_cd,
//  card1/card4/card6, addr1, P_emaildomain, DeviceType, DeviceInfo, isFraud).
//
// "Case" is a GSQL keyword, so investigation cases are stored as FraudCase.

USE GLOBAL
DROP GRAPH HHGOA_IEEE

CREATE VERTEX Transaction (PRIMARY_ID txn_id STRING, amount DOUBLE, ts INT, product_cd STRING,
    is_fraud INT DEFAULT -1, chargeback BOOL DEFAULT "false") WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID card_id STRING, card1 INT, card4 STRING, card6 STRING,
    issuer_country STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Device (PRIMARY_ID device_id STRING, device_type STRING, device_info STRING)
    WITH primary_id_as_attribute="true"
CREATE VERTEX Customer (PRIMARY_ID customer_id STRING, tenure_days INT, addr1 INT, p_emaildomain STRING,
    kyc_level STRING, segment STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX IP (PRIMARY_ID ip_id STRING, country STRING, is_proxy BOOL, asn STRING)
    WITH primary_id_as_attribute="true"
CREATE VERTEX FraudCase (PRIMARY_ID case_id STRING, status STRING, pattern_tags SET<STRING>, outcome STRING,
    summary STRING, decision STRING, confidence DOUBLE, opened_ts INT, closed_ts INT,
    sar_filed BOOL DEFAULT "false", evidence_ids STRING) WITH primary_id_as_attribute="true"

CREATE UNDIRECTED EDGE PAID_WITH   (FROM Transaction, TO Card)
CREATE UNDIRECTED EDGE USED_DEVICE (FROM Transaction, TO Device)
CREATE UNDIRECTED EDGE FROM_IP     (FROM Transaction, TO IP)
CREATE UNDIRECTED EDGE PLACED_BY   (FROM Transaction, TO Customer)
CREATE UNDIRECTED EDGE HOLDS       (FROM Customer, TO Card)
CREATE UNDIRECTED EDGE USES_DEVICE (FROM Customer, TO Device)
CREATE UNDIRECTED EDGE USES_IP     (FROM Customer, TO IP)
CREATE UNDIRECTED EDGE INVESTIGATES(FROM FraudCase, TO Transaction)
CREATE UNDIRECTED EDGE CONCERNS    (FROM FraudCase, TO Customer)

CREATE GRAPH HHGOA_IEEE (Transaction, Card, Device, Customer, IP, FraudCase,
    PAID_WITH, USED_DEVICE, FROM_IP, PLACED_BY, HOLDS, USES_DEVICE, USES_IP, INVESTIGATES, CONCERNS)
