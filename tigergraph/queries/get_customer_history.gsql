// Customer baseline before as_of_ts, excluding the final 24h so that bursts do not mask themselves.
CREATE OR REPLACE QUERY get_customer_history(VERTEX<Customer> customer_id, INT as_of_ts,
                                             INT lookback_days = 365) FOR GRAPH HHGOA_IEEE {
  TYPEDEF TUPLE<STRING case_id, STRING outcome> PriorCase;
  SumAccum<INT> @@n, @@cb;
  SumAccum<DOUBLE> @@total;
  MaxAccum<DOUBLE> @@max_amt;
  MaxAccum<INT> @@last_ts;
  SetAccum<STRING> @@devices, @@countries, @@cards;
  ListAccum<PriorCase> @@prior;

  Cu = {customer_id};
  T = SELECT t FROM Cu:u -(PLACED_BY)- Transaction:t
      WHERE t.ts < as_of_ts - 86400 AND t.ts >= as_of_ts - lookback_days * 86400
      ACCUM @@n += 1, @@total += t.amount, @@max_amt += t.amount, @@last_ts += t.ts,
            IF t.chargeback THEN @@cb += 1 END;
  X = SELECT d FROM T:t -(USED_DEVICE)- Device:d ACCUM @@devices += d.device_id;
  X = SELECT i FROM T:t -(FROM_IP)- IP:i ACCUM @@countries += i.country;
  X = SELECT c FROM Cu:u -(HOLDS)- Card:c ACCUM @@cards += c.card_id;
  X = SELECT k FROM Cu:u -(CONCERNS)- FraudCase:k WHERE k.status == "closed"
      ACCUM @@prior += PriorCase(k.case_id, k.outcome);

  PRINT Cu AS customer;
  PRINT @@n AS txn_count, @@total AS total_amount, @@max_amt AS max_amount, @@cb AS chargeback_count,
        @@devices AS known_device_ids, @@countries AS known_ip_countries, @@cards AS cards,
        @@last_ts AS last_ts, @@prior AS prior_cases;
}
