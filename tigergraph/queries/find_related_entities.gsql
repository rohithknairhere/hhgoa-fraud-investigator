// Bounded BFS (1-3 hops) from any vertex, point-in-time, skipping open cases.
CREATE OR REPLACE QUERY find_related_entities(VERTEX root_id, INT hops = 2, INT as_of_ts,
                                              INT max_rows = 50) FOR GRAPH HHGOA_IEEE {
  OrAccum @visited;
  MinAccum<INT> @hop;
  SumAccum<INT> @@depth;
  MapAccum<STRING, SumAccum<INT>> @@counts;
  SetAccum<VERTEX> @@fraud_txns, @@confirmed_cases;

  Root = {root_id};
  Frontier = SELECT s FROM Root:s POST-ACCUM s.@visited = TRUE, s.@hop = 0;
  Seen = Frontier;
  WHILE Frontier.size() > 0 LIMIT hops DO
    @@depth += 1;
    Frontier = SELECT t FROM Frontier:s -(:e)- :t
               WHERE t.@visited == FALSE
                 AND NOT (t.type == "Transaction" AND t.getAttr("ts", "INT") > as_of_ts)
                 AND NOT (t.type == "FraudCase" AND t.getAttr("status", "STRING") != "closed")
               POST-ACCUM t.@visited = TRUE, t.@hop = @@depth;
    Seen = Seen UNION Frontier;
  END;

  Related = SELECT v FROM Seen:v WHERE v != root_id
            ACCUM @@counts += (v.type -> 1),
                  IF v.type == "Transaction" AND v.getAttr("is_fraud", "INT") == 1 THEN @@fraud_txns += v END,
                  IF v.type == "FraudCase" AND v.getAttr("outcome", "STRING") == "confirmed_fraud"
                  THEN @@confirmed_cases += v END;
  Entities = SELECT v FROM Related:v ORDER BY v.@hop ASC LIMIT max_rows;

  PRINT Root AS root;
  PRINT Entities[Entities.@hop] AS entities;
  PRINT @@counts AS counts, @@fraud_txns AS fraud_transactions, @@confirmed_cases AS confirmed_fraud_cases;
}
