// GraphRAG case-memory retrieval. Closed cases are scored by
//   0.6 * Jaccard(pattern tags) + 0.4 * [shares a card/device/IP/customer with this transaction]
CREATE OR REPLACE QUERY find_similar_cases(VERTEX<Transaction> txn, SET<STRING> tags, INT k = 5)
FOR GRAPH HHGOA_IEEE {
  OrAccum @overlap;
  SetAccum<VERTEX> @shared;
  SumAccum<INT> @inter;
  SumAccum<DOUBLE> @score;

  Start = {txn};
  Hubs = SELECT h FROM Start:s -((PAID_WITH|USED_DEVICE|FROM_IP|PLACED_BY))- :h;
  HubT = SELECT t FROM Hubs:h -((PAID_WITH|USED_DEVICE|FROM_IP|PLACED_BY))- Transaction:t ACCUM t.@shared += h;
  X = SELECT c FROM HubT:t -(INVESTIGATES)- FraudCase:c ACCUM c.@overlap += TRUE, c.@shared += t.@shared;
  X = SELECT c FROM Hubs:h -(CONCERNS)- FraudCase:c ACCUM c.@overlap += TRUE, c.@shared += h;

  Cases = {FraudCase.*};
  Cases = SELECT c FROM Cases:c WHERE c.status == "closed"
          POST-ACCUM FOREACH tg IN c.pattern_tags DO
                       IF tags.contains(tg) THEN c.@inter += 1 END
                     END;
  Cases = SELECT c FROM Cases:c
          POST-ACCUM c.@score = 0.6 * (CASE WHEN tags.size() + c.pattern_tags.size() - c.@inter > 0
                                            THEN c.@inter * 1.0 / (tags.size() + c.pattern_tags.size() - c.@inter)
                                            ELSE 0 END)
                               + (CASE WHEN c.@overlap THEN 0.4 ELSE 0 END)
          HAVING c.@score >= 0.25
          ORDER BY c.@score DESC, c.case_id ASC
          LIMIT k;
  PRINT Cases[Cases.@score AS similarity, Cases.@shared AS shared_entities] AS cases;
}
