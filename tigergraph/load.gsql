// Loading job for the CSVs produced by backend/scripts/export_tigergraph_csv.py
// (or your own IEEE-CIS pre-processing emitting the same columns).
USE GRAPH HHGOA_IEEE

CREATE LOADING JOB load_hhgoa FOR GRAPH HHGOA_IEEE {
  DEFINE FILENAME f_customers = "./data/customers.csv";
  DEFINE FILENAME f_cards     = "./data/cards.csv";
  DEFINE FILENAME f_devices   = "./data/devices.csv";
  DEFINE FILENAME f_ips       = "./data/ips.csv";
  DEFINE FILENAME f_txns      = "./data/transactions.csv";
  DEFINE FILENAME f_cases     = "./data/cases.csv";
  DEFINE FILENAME f_case_txns = "./data/case_transactions.csv";

  LOAD f_customers TO VERTEX Customer VALUES ($"customer_id", $"tenure_days", $"addr1", $"p_emaildomain",
       $"kyc_level", $"segment") USING header="true", separator=",";
  LOAD f_cards TO VERTEX Card VALUES ($"card_id", $"card1", $"card4", $"card6", $"issuer_country"),
       TO EDGE HOLDS VALUES ($"customer_id", $"card_id") USING header="true", separator=",";
  LOAD f_devices TO VERTEX Device VALUES ($"device_id", $"device_type", $"device_info")
       USING header="true", separator=",";
  LOAD f_ips TO VERTEX IP VALUES ($"ip_id", $"country", $"is_proxy", $"asn") USING header="true", separator=",";
  LOAD f_txns TO VERTEX Transaction VALUES ($"txn_id", $"amount", $"ts", $"product_cd", $"is_fraud", $"chargeback"),
       TO EDGE PAID_WITH   VALUES ($"txn_id", $"card_id"),
       TO EDGE USED_DEVICE VALUES ($"txn_id", $"device_id"),
       TO EDGE FROM_IP     VALUES ($"txn_id", $"ip_id"),
       TO EDGE PLACED_BY   VALUES ($"txn_id", $"customer_id"),
       TO EDGE USES_DEVICE VALUES ($"customer_id", $"device_id"),
       TO EDGE USES_IP     VALUES ($"customer_id", $"ip_id")
       USING header="true", separator=",";
  LOAD f_cases TO VERTEX FraudCase VALUES ($"case_id", $"status", SPLIT($"pattern_tags", "|"), $"outcome",
       $"summary", $"decision", _, $"opened_ts", _, $"sar_filed", _),
       TO EDGE CONCERNS VALUES ($"case_id", $"customer_id") USING header="true", separator=",", quote="double";
  LOAD f_case_txns TO EDGE INVESTIGATES VALUES ($"case_id", $"txn_id") USING header="true", separator=",";
}

RUN LOADING JOB load_hhgoa
