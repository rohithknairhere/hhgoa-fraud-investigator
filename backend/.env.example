# Copy to .env — never commit real values.
TG_HOST=
TG_GRAPH=HHGOA_IEEE
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
GRAPH_BACKEND=auto            # auto | tigergraph | mock
AGENT_PLANNER=deterministic   # deterministic | claude
ANTHROPIC_API_KEY=
ENFORCE_HTTPS=true
ALLOW_LOCAL_HTTP=true         # loopback-only exemption for local dev
FRONTEND_ORIGIN=https://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
